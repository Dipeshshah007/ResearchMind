# Copy to .env and fill in ONE provider. All are free.
# LLM_PROVIDER auto-detects from keys if left blank: gemini -> groq -> mock

# Option A (recommended): Google Gemini free tier — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Option B: Groq free tier — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option C: fully local, unlimited — install https://ollama.com then `ollama pull llama3.2`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Force a provider: gemini | groq | ollama | mock
LLM_PROVIDER=

# Optional
SEMANTIC_SCHOLAR_API_KEY=
CONTACT_EMAIL=you@example.com
MAX_CONTEXT_CHARS=14000
FEED_TTL_SECONDS=300
